---
import type { ICar } from "@/db/models";

interface Props {
    car: ICar;
}

const { car } = Astro.props;

const fields: { label: string; value: unknown }[] = [
    { label: "Modelo", value: car.model },
    { label: "Descripción", value: car.description },
    { label: "Usado", value: car.is_used ? "Sí" : "No" },
];

const visibleFields = fields.filter((field) =>
    field.value !== undefined && field.value !== null && field.value !== ""
);
---

<section class="mb-5">
    <h2 class="font-display text-xl sm:text-2xl font-medium text-text mb-2.5">
        Información del Auto
    </h2>
    <ul class="list-none p-0">
        {
            visibleFields.map((field) => (
                <li class="mb-2 text-base text-text-secondary">
                    <strong class="text-text font-medium">{field.label}:</strong>{" "}
                    {String(field.value)}
                </li>
            ))
        }
    </ul>
</section>
