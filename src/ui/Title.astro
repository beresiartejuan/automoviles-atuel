---
interface Props {
    tag: "h1" | "h2" | "h3" | "h4";
    variant?: "primary" | "secondary" | "highlight" | "compac";
    className?: string;
}

const { tag: Tag, variant = "primary", className = "" } = Astro.props;

const variants: Record<NonNullable<Props["variant"]>, string> = {
    primary:
        "font-sans text-4xl sm:text-5xl font-semibold text-surface [text-shadow:2px_2px_5px_rgba(0,0,0,0.7)]",
    secondary:
        "font-display text-3xl font-medium text-center text-text",
    highlight:
        "text-3xl sm:text-4xl font-medium underline text-center text-brand-500",
    compac: "w-fit mx-auto font-display text-2xl sm:text-3xl font-semibold text-center text-text",
};
---

<Tag class={`text-balance m-0 ${variants[variant]} ${className}`}>
    <slot />
</Tag>
