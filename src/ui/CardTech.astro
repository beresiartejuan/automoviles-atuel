---
import type { ICarInfo } from "@/db/models";

interface Props {
    info: ICarInfo;
}

const { info } = Astro.props;

const fields: { label: string; value: unknown; suffix?: string }[] = [
    { label: "Kilometraje", value: info.mileage },
    { label: "Tracción", value: info.traction },
    { label: "Tipo de Combustible", value: info.fuel_type },
    { label: "Transmisión", value: info.transmission_type },
    {
        label: "Capacidad del Tanque",
        value: info.fuel_tank_capacity_liters,
        suffix: " L",
    },
    { label: "Tipo de Motor", value: info.engine_type },
];

const visibleFields = fields.filter((field) =>
    field.value !== undefined && field.value !== null && field.value !== ""
);
---

<section class="mb-5">
    <h2 class="font-display text-xl sm:text-2xl font-medium text-text mb-2.5">
        Ficha Técnica
    </h2>
    <ul class="list-none p-0">
        {
            visibleFields.map((field) => (
                <li class="mb-2 text-base text-text-secondary">
                    <strong class="text-text font-medium">{field.label}:</strong>{" "}
                    {String(field.value)}{field.suffix}
                </li>
            ))
        }
    </ul>
</section>
