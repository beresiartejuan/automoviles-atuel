---
import type { ICar, ICarPhoto } from "@/db/models";

interface Props {
    photos: Array<ICarPhoto>;
    name: ICar["name"];
}

const { photos, name } = Astro.props;
---

<section class="text-center px-4 py-8">
    <h2 class="font-sans text-2xl sm:text-3xl font-semibold text-text mb-4">
        Fotos
    </h2>
    <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 justify-center items-center max-w-7xl mx-auto p-4"
    >
        {
            photos.map((photo) => (
                <img
                    src={photo.photo_url}
                    alt={`Foto de ${name}`}
                    class="w-full aspect-[16/10] object-cover rounded-[var(--radius-card)] shadow-[var(--shadow-card)] transition duration-300 ease-out hover:scale-[1.03] hover:shadow-lg"
                />
            ))
        }
    </div>
</section>
