---
import type { ICar, ICarPhoto } from "@/db/models";

interface Props {
    name: ICar["name"];
    year: ICar["year"];
    photo: ICarPhoto;
}

const { name, year, photo } = Astro.props;
---

<div class="text-center mb-5">
    <h1 class="font-sans text-3xl sm:text-4xl font-semibold text-text mb-3">
        {name} ({year})
    </h1>
    <img
        src={photo.photo_url}
        alt={`Foto de ${name}`}
        class="w-full max-w-md mx-auto mt-2 aspect-[16/10] object-cover rounded-[var(--radius-card)] shadow-[var(--shadow-card)]"
    />
</div>
