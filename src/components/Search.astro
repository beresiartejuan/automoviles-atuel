---
const url = new URL(Astro.url);
const searchTerm = url.searchParams.get("q") ?? "";
const estado = url.searchParams.get("estado") ?? "todos";

const options = [
    { value: "todos", label: "Todos" },
    { value: "0km", label: "0km" },
    { value: "usado", label: "Usados" },
];
---

<div class="mx-auto w-full max-w-3xl px-4 py-6">
    <form
        id="search-form"
        class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4"
        action="/autos"
        method="GET"
    >
        <div class="relative flex-1">
            <input
                id="search-input"
                name="q"
                type="search"
                value={searchTerm}
                placeholder="Buscar por marca o modelo…"
                class="w-full rounded-radius-card border border-border bg-surface px-4 py-3 font-sans text-base text-text shadow-sm placeholder:text-text-secondary focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
            />
        </div>

        <div
            id="estado-control"
            class="flex flex-wrap items-center gap-1 rounded-radius-pill border border-border bg-surface p-1"
            role="group"
            aria-label="Filtrar por estado"
        >
            {
                options.map((opt) => (
                    <button
                        type="button"
                        data-value={opt.value}
                        class={`estado-btn rounded-radius-pill px-4 py-2 font-sans text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-brand-500/30 ${estado === opt.value ? "bg-brand-500 text-white" : "text-text-secondary hover:bg-accent-soft hover:text-text"}`}
                        aria-pressed={estado === opt.value ? "true" : "false"}
                    >
                        {opt.label}
                    </button>
                ))
            }
        </div>

        <input id="estado-input" type="hidden" name="estado" value={estado} />

        <button
            type="submit"
            class="inline-flex items-center justify-center rounded-radius-card bg-brand-500 px-5 py-3 font-sans text-sm font-semibold text-white transition hover:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500"
        >
            Buscar
        </button>
    </form>
</div>

<script>
    const form = document.querySelector("#search-form") as HTMLFormElement;
    const estadoInput = document.querySelector("#estado-input") as HTMLInputElement;
    const buttons = document.querySelectorAll(".estado-btn");

    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const value = (btn as HTMLElement).dataset.value ?? "todos";
            estadoInput.value = value;

            buttons.forEach((b) => {
                const isSelected = b === btn;
                b.setAttribute("aria-pressed", isSelected ? "true" : "false");
                b.classList.toggle("bg-brand-500", isSelected);
                b.classList.toggle("text-white", isSelected);
                b.classList.toggle("text-text-secondary", !isSelected);
                b.classList.toggle("hover:bg-accent-soft", !isSelected);
                b.classList.toggle("hover:text-text", !isSelected);
            });

            form.requestSubmit();
        });
    });

    form.addEventListener("submit", (e) => {
        const input = form.querySelector("#search-input") as HTMLInputElement;
        const params = new URLSearchParams();
        const q = input.value.trim();
        if (q) params.set("q", q);
        if (estadoInput.value && estadoInput.value !== "todos") {
            params.set("estado", estadoInput.value);
        }
        e.preventDefault();
        window.location.href = `/autos?${params.toString()}`;
    });
</script>
