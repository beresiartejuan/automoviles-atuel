---
import type { CarListItem } from "@/db/cars";
import Card from "./Card.astro";

interface Props {
    items: CarListItem[];
}

const { items } = Astro.props;
---

<section
    class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-6 px-4 py-6 sm:grid-cols-2 lg:grid-cols-3"
    aria-label="Listado de autos"
>
    {items.map((item) => <Card {...item} />)}
</section>
