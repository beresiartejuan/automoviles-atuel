---
import type { CarListItem } from "@/db/cars";
import Card from "./Card.astro";

interface Props {
    items: CarListItem[];
}

const { items } = Astro.props;
---

<section class="cards">
    {items.map((item) => <Card {...item} />)}
</section>

<style lang="scss">
    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        gap: 1rem;
        max-width: 70vw;
        width: fit-content;
        margin: 0 auto;
        padding: 1rem;
        box-sizing: border-box;
        border: 1px solid transparent;

        @media screen and (width < 900px) {
            max-width: 100vw;
        }
    }
</style>
