---
import type { CarListItem } from "@db/cars";

interface Props extends CarListItem {}

const { props } = Astro;

const { car, mainPhotoUrl: photo } = props;

const href = `/autos/${car.id}`;
const badgeText = car.is_used ? "USADO" : "0KM";
const badgeClasses = car.is_used
    ? "bg-text-secondary/90 text-white"
    : "bg-brand-500 text-white";
---

<article
    class="group relative flex max-w-[18rem] flex-col overflow-hidden rounded-radius-card bg-surface shadow-card transition-all duration-300 ease-out hover:shadow-[0_8px_20px_rgba(0,0,0,0.45)] focus-within:shadow-[0_8px_20px_rgba(0,0,0,0.45)]"
    aria-labelledby={`card-title-${car.id}`}
>
    <a href={href} class="contents" aria-label={`Ver detalle de ${car.name} ${car.model} ${car.year}`}>
        <div class="relative aspect-[16/10] w-full overflow-hidden">
            {
                photo ? (
                    <img
                        src={photo}
                        alt={`${car.name} ${car.model} ${car.year}`}
                        class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
                        loading="lazy"
                    />
                ) : (
                    <div class="flex h-full w-full flex-col items-center justify-center bg-gray-200 text-text-secondary">
                        <svg
                            aria-hidden="true"
                            class="mb-2 h-10 w-10"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                        >
                            <path d="M3 8l7.89 4.65a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        <span class="font-sans text-sm">Sin fotos</span>
                    </div>
                )
            }

            <span
                class={`absolute left-3 top-3 rounded-radius-pill px-3 py-1 font-display text-xs font-semibold tracking-wide ${badgeClasses}`}
            >
                {badgeText}
            </span>
        </div>

        <div class="flex flex-col gap-1 p-4">
            <h4
                id={`card-title-${car.id}`}
                class="font-display text-lg font-semibold leading-tight text-text truncate"
                title={`${car.name} ${car.model}`}
            >
                {car.name}
            </h4>
            <p class="font-sans text-sm text-text-secondary">
                {car.model} · {car.year}
            </p>

            {/* Espacio reservado para precio cuando esté disponible */}
            {/* <p class="font-display text-xl font-bold text-text mt-1">$ ...</p> */}

            <span
                class="mt-3 inline-flex items-center gap-1 font-sans text-sm font-medium text-brand-500 group-hover:text-brand-600 transition-colors"
                aria-hidden="true"
            >
                Consultar <span aria-hidden="true">→</span>
            </span>
        </div>
    </a>
</article>
