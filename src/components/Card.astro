---
import type { CarListItem } from "@db/cars";

interface Props extends CarListItem {}

const { props } = Astro;

const { car, mainPhotoUrl: photo } = props;
---

<div
    class="card"
    role="article"
    car-id={car.id}
    aria-labelledby={`card-title-${car.id}`}
>
    {
        photo ? (
            <div class="card__image">
                <img
                    src={photo}
                    alt={`Imagen de ${car.name}, modelo ${car.model}`}
                    loading="lazy"
                />
            </div>
        ) : (
            ""
        )
    }

    <div class="card__info">
        <h4 id={`card-title-${car.id}`} class="card__info__title">
            {car.name}
        </h4>
        <p class="card__info__details">
            <span class="card__info__model">{car.model} | {car.year}</span>
            <span class="card__info__year-mileage">
                {car.is_used ? "" : "0km"}
            </span>
        </p>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll("div.card[car-id]").forEach((card) => {
            if (!card.getAttribute("car-id")) return;

            const car_id = card.getAttribute("car-id")!;

            card.addEventListener("click", (e) => {
                e.preventDefault();
                window.location.href = `/autos/${car_id}`;
            });
        });
    });
</script>

<style lang="scss">
    :root {
        --color-bg: #fff;
        --color-shadow: rgba(0, 0, 0, 0.2);
        --color-shadow-hover: #00000073;
        --color-text: #333;
        --color-muted: #888;
        --color-button: #222425;
        --color-button-hover: #0056b3;
        --border-radius: 10px;
        --spacing: 10px;
    }

    .card {
        font-family: "Kanit", sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: var(--color-bg);
        border-radius: var(--border-radius);
        box-shadow: 0 4px 10px var(--color-shadow);
        max-width: 18rem;
        overflow: hidden;
        // cursor: pointer;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;

        &:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px var(--color-shadow-hover);
        }

        &__image img {
            aspect-ratio: 1/1;
            width: 100%;
            height: auto;
            object-fit: cover;
            border-bottom: 1px solid #e0e0e0;
        }

        &__info {
            padding: var(--spacing);
            width: 100%;
            text-align: center;

            &__title {
                font-size: 1.3rem;
                font-weight: 600;
                color: var(--color-text);
                margin: var(--spacing) 0;
            }

            &__details {
                font-size: 1rem;
                color: var(--color-muted);
                margin-bottom: var(--spacing);
                font-weight: 300;
                text-align: left;
                padding-left: 5%;

                span {
                    display: block;
                    line-height: 1.4rem;
                }
            }
        }
    }
</style>
