---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Iniciar sesión" showFab={false}>
    <main class="flex min-h-[80vh] items-center justify-center px-4 py-12">
        <form
            class="login w-full max-w-md space-y-6 rounded-radius-card bg-surface p-6 shadow-card sm:p-8"
            action="/login"
            method="POST"
        >
            <h1 class="text-center font-display text-2xl font-semibold text-text">
                Iniciar Sesión
            </h1>

            <div class="space-y-2">
                <label
                    for="username"
                    class="block text-sm font-semibold text-text"
                >
                    Usuario
                </label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Tu usuario"
                    required
                    class="w-full rounded-radius-card border border-border bg-background px-4 py-3 text-text outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
                />
            </div>

            <div class="space-y-2">
                <label
                    for="password"
                    class="block text-sm font-semibold text-text"
                >
                    Contraseña
                </label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Tu contraseña"
                    required
                    class="w-full rounded-radius-card border border-border bg-background px-4 py-3 text-text outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-200"
                />
            </div>

            <button
                type="submit"
                id="login-button"
                class="inline-flex w-full items-center justify-center rounded-radius-card bg-brand-500 px-6 py-3 text-base font-semibold text-white transition hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-60"
            >
                <span id="login-button-text">Ingresar</span>
                <svg
                    id="login-spinner"
                    class="ml-2 hidden h-5 w-5 animate-spin text-white"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <circle
                        class="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        stroke-width="4"
                    ></circle>
                    <path
                        class="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    ></path>
                </svg>
            </button>

            <p
                id="responseMessage"
                class="hidden text-center text-sm font-medium text-danger"
                role="alert"
            >
                Usuario o contraseña incorrectos.
            </p>
        </form>
    </main>
</Layout>

<script>
    const login = document.querySelector("form.login") as HTMLFormElement | null;
    const responseMessage = document.getElementById(
        "responseMessage",
    ) as HTMLParagraphElement | null;
    const loginButton = document.getElementById(
        "login-button",
    ) as HTMLButtonElement | null;
    const loginButtonText = document.getElementById(
        "login-button-text",
    ) as HTMLSpanElement | null;
    const loginSpinner = document.getElementById(
        "login-spinner",
    ) as HTMLElement | null;

    function setLoading(loading: boolean) {
        if (loginButton) loginButton.disabled = loading;
        if (loginSpinner) loginSpinner.classList.toggle("hidden", !loading);
        if (loginButtonText)
            loginButtonText.textContent = loading ? "Ingresando…" : "Ingresar";
    }

    function showError() {
        if (responseMessage) {
            responseMessage.classList.remove("hidden");
            responseMessage.textContent = "Usuario o contraseña incorrectos";
        }
    }

    async function handleLogin(credentials: {
        username: string;
        password: string;
    }): Promise<{ ok: boolean; message: string }> {
        try {
            const response = await fetch("/api/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(credentials),
            });

            const data = await response.json();
            return { ok: response.ok, message: data.message as string };
        } catch (error) {
            console.error(error);
            return { ok: false, message: "Error en el servidor" };
        }
    }

    login?.addEventListener("submit", async (e) => {
        e.preventDefault();
        setLoading(true);
        if (responseMessage) responseMessage.classList.add("hidden");

        const data = new FormData(e.currentTarget as HTMLFormElement);
        const payload = {
            username: data.get("username")!.toString(),
            password: data.get("password")!.toString(),
        };

        const response = await handleLogin(payload);

        setLoading(false);

        if (response.ok) {
            if (typeof window.showToast === "function") {
                window.showToast("Sesión iniciada", "success");
            }
            setTimeout(() => {
                window.location.href = "/panel";
            }, 500);
        } else {
            showError();
        }
    });
</script>
