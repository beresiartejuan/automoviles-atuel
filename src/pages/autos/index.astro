---
import Layout from "@/layouts/Layout.astro";
import SearchBar from "@/components/Search.astro";
import Header from "@/components/Header.astro";
import { list_cars_with_main_photo } from "@db/cars";
import CardList from "@/components/CardList.astro";

const url = new URL(Astro.url);
const searchTerm = url.searchParams.get("q")?.toLowerCase() || "";
const status = url.searchParams.has("nuevo");

const items = await list_cars_with_main_photo(true, searchTerm, status ? false : true);

---

<Layout>
    <Header />
    <SearchBar />
    <CardList items={items} />
</Layout>

<style>
    h3 {
        max-width: fit-content;
        margin: 0 auto;
        font-family: "Kanit", sans-serif;
        font-weight: 600;
        font-size: 2.5rem;
        margin-top: 8vh;
        text-align: center;
        text-wrap: balance;
    }
</style>
