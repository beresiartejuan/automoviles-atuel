---
import "../styles/main.css";
import "@fontsource/kanit/600.css";
import "@fontsource/kanit/700.css";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import Head from "@/components/Head.astro";
import Footer from "@/components/Footer.astro";

import { SITEWEB_DESCRIPTION, SITEWEB_TITLE } from "../config";
import Navbar from "@/components/Navbar.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import Toast from "@/components/Toast.astro";
import ConfirmModal from "@/components/ConfirmModal.astro";

interface Props {
	title?: string;
	description?: string;
	showFab?: boolean;
}

const { title, description, showFab = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-background text-text antialiased">
	<head>
		<Head
			title={title ?? SITEWEB_TITLE}
			description={description ?? SITEWEB_DESCRIPTION}
		/>
	</head>
	<body class="m-0 min-h-screen w-full font-sans">
		<Navbar />
		<slot />
		<Footer />
		{showFab && <WhatsAppFab />}
		<Toast />
		<ConfirmModal />
	</body>
</html>
